import { useState, useMemo } from "react";
import {
  useReactTable,
  getCoreRowModel,
  getSortedRowModel,
  getFilteredRowModel,
  getPaginationRowModel,
  flexRender,
  createColumnHelper,
  SortingState,
  ColumnDef,
} from "@tanstack/react-table";

// ─── Types ────────────────────────────────────────────────────────────────────

type Status = "Active" | "Away" | "Offline";

interface Person {
  id: number;
  name: string;
  role: string;
  status: Status;
  score: number;
  location: string;
  joined: string;
}

// Generic — the table accepts any record type
interface DynamicTableProps<T extends Record<string, unknown>> {
  data?: T[];
  /** Optional: manually provide TanStack ColumnDefs instead of auto-generating */
  columns?: ColumnDef<T, unknown>[];
}

