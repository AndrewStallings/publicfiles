/**
 * Demo-only: pretend this is your DB/API call.
 * Replace with:
 *   await fetch(`/api/records?q=${encodeURIComponent(q)}`, { signal })
 * or a server action / tRPC / Prisma route.
 */
async function searchRecordsFromDb(q: string, signal: AbortSignal): Promise<Item[]> {
  // artificial latency to make the loading state obvious
  await new Promise<void>((resolve, reject) => {
    const t = setTimeout(resolve, 180);
    signal.addEventListener(
      "abort",
      () => {
        clearTimeout(t);
        reject(new DOMException("Aborted", "AbortError"));
      },
      { once: true }
    );
  });

  const query = q.trim().toLowerCase();
  if (!query) return [];

  // In real life, do this on the server with a LIKE/FTS query + TOP 20.
  return sampleItems
    .filter((i) => {
      return (
        i.id.includes(query) ||
        i.title.toLowerCase().includes(query) ||
        (i.subtitle ?? "").toLowerCase().includes(query) ||
        i.fields.some((f) => f.label.toLowerCase().includes(query) || f.value.toLowerCase().includes(query))
      );
    })
    .slice(0, 8);
}

function useDebouncedValue<T>(value: T, delayMs: number) {
  const [debounced, setDebounced] = useState(value);
  useEffect(() => {
    const t = setTimeout(() => setDebounced(value), delayMs);
    return () => clearTimeout(t);
  }, [value, delayMs]);
  return debounced;
}

