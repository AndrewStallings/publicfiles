type SearchBoxProps = {
  placeholder?: string;
  minChars?: number;
  debounceMs?: number;
  onPick: (item: Item) => void;
};

/**
 * Snappy DB-backed search box:
 * - debounce (so you don’t hammer the DB)
 * - abort in-flight requests (so fast typing feels instant)
 * - tiny cache for repeated queries
 * - keyboard navigation (↑ ↓ Enter Esc)
 */
function SearchBox({ placeholder = "Search records…", minChars = 2, debounceMs = 180, onPick }: SearchBoxProps) {
  const [text, setText] = useState("");
  const debounced = useDebouncedValue(text, debounceMs);

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [results, setResults] = useState<Item[]>([]);
  const [open, setOpen] = useState(false);
  const [activeIndex, setActiveIndex] = useState(0);

  const abortRef = useRef<AbortController | null>(null);
  const cacheRef = useRef(new Map<string, Item[]>());
  const inputRef = useRef<HTMLInputElement | null>(null);

  useEffect(() => {
    const q = debounced.trim();

    // close dropdown when empty
    if (q.length < minChars) {
      abortRef.current?.abort();
      setResults([]);
      setLoading(false);
      setError(null);
      setOpen(q.length > 0);
      setActiveIndex(0);
      return;
    }

    // cached?
    const cached = cacheRef.current.get(q.toLowerCase());
    if (cached) {
      abortRef.current?.abort();
      setResults(cached);
      setLoading(false);
      setError(null);
      setOpen(true);
      setActiveIndex(0);
      return;
    }

    // new request
    abortRef.current?.abort();
    const controller = new AbortController();
    abortRef.current = controller;

    setLoading(true);
    setError(null);
    setOpen(true);

    (async () => {
      try {
        const res = await searchRecordsFromDb(q, controller.signal);
        cacheRef.current.set(q.toLowerCase(), res);
        setResults(res);
        setActiveIndex(0);
      } catch (e: any) {
        if (e?.name === "AbortError") return;
        setError("Search failed");
        setResults([]);
      } finally {
        setLoading(false);
      }
    })();

    return () => controller.abort();
  }, [debounced, minChars]);

  const hint = useMemo(() => {
    const q = text.trim();
    if (!q) return "Type to search";
    if (q.length < minChars) return `Keep typing… (${minChars - q.length} more)`;
    if (loading) return "Searching…";
    if (error) return error;
    if (!results.length) return "No matches";
    return `${results.length} match${results.length === 1 ? "" : "es"}`;
  }, [text, minChars, loading, error, results.length]);

  function pick(item: Item) {
    onPick(item);
    setText("");
    setResults([]);
    setOpen(false);
    setActiveIndex(0);
    // keep focus so it feels snappy in forms
    requestAnimationFrame(() => inputRef.current?.focus());
  }

  return (
    <div className="relative">
      <div className="group relative rounded-2xl border border-black/10 bg-white/70 shadow-sm backdrop-blur transition focus-within:border-black/20 focus-within:bg-white">
        <div className="pointer-events-none absolute inset-0 opacity-0 transition group-focus-within:opacity-100">
          <div className="absolute -top-16 left-10 h-40 w-40 rounded-full bg-violet-300/20 blur-3xl" />
          <div className="absolute -bottom-16 right-10 h-40 w-40 rounded-full bg-amber-300/20 blur-3xl" />
        </div>

        <div className="relative flex items-center gap-3 px-3 py-2">
          <span className="select-none text-gray-500">⌘</span>
          <input
            ref={inputRef}
            value={text}
            onChange={(e) => setText(e.target.value)}
            onFocus={() => setOpen(true)}
            onBlur={() => {
              // allow click selection before closing
              setTimeout(() => setOpen(false), 120);
            }}
            onKeyDown={(e) => {
              if (!open) return;
              if (e.key === "Escape") {
                setOpen(false);
                return;
              }
              if (e.key === "ArrowDown") {
                e.preventDefault();
                setActiveIndex((i) => Math.min(i + 1, Math.max(0, results.length - 1)));
              }
              if (e.key === "ArrowUp") {
                e.preventDefault();
                setActiveIndex((i) => Math.max(i - 1, 0));
              }
              if (e.key === "Enter") {
                const item = results[activeIndex];
                if (item) pick(item);
              }
            }}
            placeholder={placeholder}
            className="w-full bg-transparent py-1 text-sm text-gray-900 outline-none placeholder:text-gray-500"
            autoComplete="off"
          />

          <div className="flex items-center gap-2">
            {loading ? <Spinner /> : <span className="text-xs text-gray-500 tabular-nums">{hint}</span>}
          </div>
        </div>
      </div>

      {open && (text.trim().length > 0 || results.length > 0) && (
        <div className="absolute z-10 mt-2 w-full overflow-hidden rounded-2xl border border-black/10 bg-white/80 shadow-lg backdrop-blur">
          <div className="max-h-80 overflow-auto p-2">
            {results.length === 0 ? (
              <div className="rounded-xl border border-black/10 bg-white/60 p-3 text-sm text-gray-700">
                <div className="font-semibold">{hint}</div>
                <div className="mt-1 text-xs text-gray-500">Try ID, owner, region, or any field value.</div>
              </div>
            ) : (
              <div className="space-y-1">
                {results.map((r, idx) => {
                  const isActive = idx === activeIndex;
                  const preview = r.fields
                    .slice(0, 2)
                    .map((f) => `${f.label}: ${f.value}`)
                    .join(" • ");

                  return (
                    <button
                      key={r.id}
                      type="button"
                      onMouseEnter={() => setActiveIndex(idx)}
                      onMouseDown={(e) => e.preventDefault()} // keep focus
                      onClick={() => pick(r)}
                      className={`w-full rounded-xl border px-3 py-2 text-left transition ${
                        isActive
                          ? "border-black/10 bg-gradient-to-r from-violet-50 via-white to-amber-50 shadow-sm"
                          : "border-transparent hover:border-black/10 hover:bg-white/60"
                      }`}
                    >
                      <div className="flex items-start justify-between gap-3">
                        <div className="min-w-0">
                          <div className="truncate text-sm font-semibold text-gray-900">{r.title}</div>
                          <div className="mt-0.5 truncate text-xs text-gray-600">{r.subtitle ?? ""}</div>
                          <div className="mt-1 truncate text-xs text-gray-500">{preview}</div>
                        </div>
                        <Chip>
                          #{r.id}
                        </Chip>
                      </div>
                    </button>
                  );
                })}
              </div>
            )}
          </div>

          <div className="flex items-center justify-between border-t border-black/10 bg-white/60 px-3 py-2 text-xs text-gray-600">
            <span>
              ↑↓ to navigate • Enter to pick • Esc to close
            </span>
            <span className="tabular-nums">debounce: {debounceMs}ms</span>
          </div>
        </div>
      )}
    </div>
  );
}

