import React, { useEffect, useRef, useState } from "react";

type SearchItem = {
  id: string | number;
  label: string;
};

type AsyncSearchComboBoxProps<T extends SearchItem> = {
  search: (query: string) => Promise<T[]>;
  onSelect?: (item: T) => void;
  placeholder?: string;
  minChars?: number;
};

export const AsyncSearchComboBox = <T extends SearchItem>({
  search,
  onSelect,
  placeholder = "Search...",
  minChars = 2,
}: AsyncSearchComboBoxProps<T>) => {
  const [query, setQuery] = useState("");
  const [results, setResults] = useState<T[]>([]);
  const [isOpen, setIsOpen] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [highlightedIndex, setHighlightedIndex] = useState(-1);
  const [error, setError] = useState<string | null>(null);

  const requestIdRef = useRef(0);
  const debounceRef = useRef<number | null>(null);
  const containerRef = useRef<HTMLDivElement | null>(null);

  useEffect(() => {
    if (debounceRef.current) {
      window.clearTimeout(debounceRef.current);
    }

    const trimmed = query.trim();

    if (trimmed.length < minChars) {
      setIsLoading(false);
      setError(null);
      setResults([]);
      setHighlightedIndex(-1);
      return;
    }

    setIsLoading(true);
    setError(null);

    debounceRef.current = window.setTimeout(async () => {
      const requestId = ++requestIdRef.current;

      try {
        const data = await search(trimmed);

        // Ignore old slow responses
        if (requestId !== requestIdRef.current) return;

        setResults(data.slice(0, 100));
        setHighlightedIndex(data.length > 0 ? 0 : -1);
        setIsOpen(true);
      } catch {
        if (requestId !== requestIdRef.current) return;

        setError("Search failed. Try again.");
        setResults([]);
        setHighlightedIndex(-1);
      } finally {
        if (requestId === requestIdRef.current) {
          setIsLoading(false);
        }
      }
    }, 350);

    return () => {
      if (debounceRef.current) {
        window.clearTimeout(debounceRef.current);
      }
    };
  }, [query, search, minChars]);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (!containerRef.current?.contains(event.target as Node)) {
        setIsOpen(false);
      }
    };

    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  const selectItem = (item: T) => {
    setQuery(item.label);
    setIsOpen(false);
    setHighlightedIndex(-1);
    onSelect?.(item);
  };

  const handleKeyDown = (event: React.KeyboardEvent<HTMLInputElement>) => {
    if (!isOpen && event.key !== "Escape") {
      setIsOpen(true);
    }

    if (event.key === "ArrowDown") {
      event.preventDefault();
      setHighlightedIndex((current) =>
        results.length === 0 ? -1 : Math.min(current + 1, results.length - 1)
      );
    }

    if (event.key === "ArrowUp") {
      event.preventDefault();
      setHighlightedIndex((current) =>
        results.length === 0 ? -1 : Math.max(current - 1, 0)
      );
    }

    if (event.key === "Enter") {
      event.preventDefault();

      if (highlightedIndex >= 0 && results[highlightedIndex]) {
        selectItem(results[highlightedIndex]);
      }
    }

    if (event.key === "Escape") {
      setIsOpen(false);
      setHighlightedIndex(-1);
    }
  };

  const showDropdown =
    isOpen && (results.length > 0 || isLoading || error || query.trim().length >= minChars);

  return (
    <div ref={containerRef} className="relative w-full max-w-md">
      <div className="relative">
        <input
          value={query}
          onChange={(event) => {
            setQuery(event.target.value);
            setIsOpen(true);
          }}
          onFocus={() => setIsOpen(true)}
          onKeyDown={handleKeyDown}
          placeholder={placeholder}
          className="w-full rounded-xl border border-gray-300 bg-white px-4 py-2 pr-10 text-sm shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
        />

        {isLoading && (
          <div className="absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 animate-spin rounded-full border-2 border-gray-300 border-t-blue-600" />
        )}
      </div>

      {showDropdown && (
        <div className="absolute z-50 mt-2 max-h-72 w-full overflow-hidden rounded-xl border border-gray-200 bg-white shadow-lg">
          {error && (
            <div className="px-4 py-3 text-sm text-red-600">
              {error}
            </div>
          )}

          {!error && results.length === 0 && isLoading && (
            <div className="px-4 py-3 text-sm text-gray-500">
              Searching...
            </div>
          )}

          {!error && results.length === 0 && !isLoading && (
            <div className="px-4 py-3 text-sm text-gray-500">
              No results found.
            </div>
          )}

          {!error && results.length > 0 && (
            <ul className="max-h-72 overflow-y-auto py-1">
              {results.map((item, index) => (
                <li key={item.id}>
                  <button
                    type="button"
                    onMouseDown={(event) => event.preventDefault()}
                    onClick={() => selectItem(item)}
                    onMouseEnter={() => setHighlightedIndex(index)}
                    className={`w-full px-4 py-2 text-left text-sm transition ${
                      highlightedIndex === index
                        ? "bg-blue-50 text-blue-700"
                        : "text-gray-800 hover:bg-gray-50"
                    }`}
                  >
                    {item.label}
                  </button>
                </li>
              ))}
            </ul>
          )}

          {results.length >= 100 && (
            <div className="border-t border-gray-100 px-4 py-2 text-xs text-gray-500">
              Showing first 100 results. Try a more specific search.
            </div>
          )}
        </div>
      )}
    </div>
  );
};
