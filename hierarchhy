"use client";

import Link from "next/link";
import { useMemo, useState } from "react";

export type HierarchyFieldValue = string | number | null | undefined;

export type HierarchyFieldDefinition<TFieldKey extends string = string> = {
  key: TFieldKey;
  label: string;
};

export type HierarchyNode<TFieldKey extends string = string> = {
  id: string;
  parentId?: string | null;
  partVersion?: string;
  serialNumber?: string;
  title: string;
  subtitle?: string;
  status?: string;
  fields: Record<TFieldKey, HierarchyFieldValue>;
};

export type HierarchySortMode = "level" | "branch";
export type HierarchyViewMode = "matrix" | "stack";

type PreparedNode<TFieldKey extends string = string> = HierarchyNode<TFieldKey> & {
  children: PreparedNode<TFieldKey>[];
  color: string;
  depth: number;
  rootId: string;
  path: string[];
};

export type HierarchyExplorerProps<TFieldKey extends string = string> = {
  title?: string;
  description?: string;
  className?: string;
  nodes: HierarchyNode<TFieldKey>[];
  fields: HierarchyFieldDefinition<TFieldKey>[];
  isLoading?: boolean;
  error?: string | null;
  isSubmitting?: boolean;
  emptyMessage?: string;
  initialSortMode?: HierarchySortMode;
  initialViewMode?: HierarchyViewMode;
  selectedNodeId?: string;
  buildHref?: (node: HierarchyNode<TFieldKey>) => string;
  onNodeSelect?: (node: HierarchyNode<TFieldKey>) => void;
};

const accentColors = [
  "#00249C",
  "#00B884",
  "#FF9500",
  "#C936F4",
  "#18A9BE",
  "#FF2E63",
  "#64C900",
  "#8B5CF6",
  "#D91E5B",
  "#287C71",
  "#C25600",
  "#5B3FD6",
  "#7A4D00",
  "#0087A8",
  "#A83279",
  "#526500",
];

export function HierarchyExplorer<TFieldKey extends string>({
  title = "Hierarchy explorer",
  description = "Review hierarchical records by level or by full branch.",
  className = "",
  nodes,
  fields,
  isLoading = false,
  error = null,
  isSubmitting = false,
  emptyMessage = "No hierarchy records are available.",
  initialSortMode = "level",
  initialViewMode = "matrix",
  selectedNodeId,
  buildHref = (node) => `/${node.id}`,
  onNodeSelect,
}: HierarchyExplorerProps<TFieldKey>) {
  const [sortMode, setSortMode] = useState<HierarchySortMode>(initialSortMode);
  const [viewMode, setViewMode] = useState<HierarchyViewMode>(initialViewMode);
  const [internalSelectedNodeId, setInternalSelectedNodeId] = useState<
    string | undefined
  >(selectedNodeId);

  const preparedHierarchy = useMemo(() => prepareHierarchy(nodes), [nodes]);
  const orderedNodes = useMemo(
    () => orderNodes(preparedHierarchy.roots, sortMode),
    [preparedHierarchy.roots, sortMode],
  );

  const activeNodeId =
    selectedNodeId ?? internalSelectedNodeId ?? orderedNodes[0]?.id;
  const activeNode = activeNodeId
    ? preparedHierarchy.nodeById.get(activeNodeId)
    : undefined;
  const activePath =
    activeNode?.path
      .map((id) => preparedHierarchy.nodeById.get(id))
      .filter((node): node is PreparedNode<TFieldKey> => Boolean(node)) ?? [];

  function selectNode(node: PreparedNode<TFieldKey>) {
    if (isSubmitting) {
      return;
    }

    setInternalSelectedNodeId(node.id);
    onNodeSelect?.(node);
  }

  return (
    <section
      className={`w-full min-w-0 text-slate-950 dark:text-zinc-50 ${className}`}
    >
      <div className="flex w-full min-w-0 flex-col gap-5">
        <header className="flex min-w-0 flex-col gap-4 border-b border-slate-200 pb-5 dark:border-zinc-800 md:flex-row md:items-end md:justify-between">
          <div className="min-w-0 max-w-3xl">
            <p className="text-sm font-semibold uppercase tracking-[0.18em] text-[#5C9DAE]">
              Structure view
            </p>
            <h1 className="mt-2 text-2xl font-semibold text-[#00249C] dark:text-zinc-50 sm:text-3xl">
              {title}
            </h1>
            <p className="mt-2 text-sm leading-6 text-slate-600 dark:text-zinc-400">
              {description}
            </p>
          </div>

          <div className="flex min-w-0 flex-wrap gap-3">
            <SegmentedControl
              label="Sort"
              value={sortMode}
              isDisabled={isSubmitting}
              options={[
                { value: "level", label: "Level order" },
                { value: "branch", label: "Branch scope" },
              ]}
              onChange={(value) => setSortMode(value as HierarchySortMode)}
            />
            <SegmentedControl
              label="View"
              value={viewMode}
              isDisabled={isSubmitting}
              options={[
                { value: "matrix", label: "Matrix" },
                { value: "stack", label: "Stack" },
              ]}
              onChange={(value) => setViewMode(value as HierarchyViewMode)}
            />
          </div>
        </header>

        {isLoading ? (
          <LoadingState />
        ) : error ? (
          <StatePanel
            title="Unable to load hierarchy"
            message={error}
            tone="error"
          />
        ) : orderedNodes.length === 0 ? (
          <StatePanel title="Nothing to show" message={emptyMessage} />
        ) : viewMode === "matrix" ? (
          <MatrixView
            nodes={orderedNodes}
            fields={fields}
            activeNode={activeNode}
            nodeById={preparedHierarchy.nodeById}
            buildHref={buildHref}
            isSubmitting={isSubmitting}
            onSelect={selectNode}
          />
        ) : (
          <StackView
            nodes={orderedNodes}
            fields={fields}
            activeNode={activeNode}
            activePath={activePath}
            nodeById={preparedHierarchy.nodeById}
            buildHref={buildHref}
            isSubmitting={isSubmitting}
            onSelect={selectNode}
          />
        )}
      </div>
    </section>
  );
}

function MatrixView<TFieldKey extends string>({
  nodes,
  fields,
  activeNode,
  nodeById,
  buildHref,
  isSubmitting,
  onSelect,
}: {
  nodes: PreparedNode<TFieldKey>[];
  fields: HierarchyFieldDefinition<TFieldKey>[];
  activeNode?: PreparedNode<TFieldKey>;
  nodeById: Map<string, PreparedNode<TFieldKey>>;
  buildHref: (node: HierarchyNode<TFieldKey>) => string;
  isSubmitting: boolean;
  onSelect: (node: PreparedNode<TFieldKey>) => void;
}) {
  const visibleFields = fields.slice(0, 7);

  return (
    <div className="min-w-0 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
      <div className="bg-[#00249C] px-4 py-3 text-sm font-semibold text-white">
        Matrix view
      </div>
      <div className="max-h-[min(42rem,70vh)] overflow-auto p-3">
        <div className="flex flex-col gap-3">
          {nodes.map((node) => {
            const nodeColor = node.color;
            const mountedToColor = getMountedToColor(node, nodeById);
            const isActive = node.id === activeNode?.id;

            return (
              <Link
                key={node.id}
                href={buildHref(node)}
                aria-disabled={isSubmitting}
                className={`block min-w-0 rounded-lg border p-4 text-left transition ${
                  isActive
                    ? "border-[#00249C] bg-blue-50 dark:bg-blue-950/20"
                    : "border-slate-200 bg-white hover:border-[#5C9DAE] dark:border-zinc-800 dark:bg-zinc-950"
                } ${isSubmitting ? "pointer-events-none opacity-60" : ""}`}
                onClick={(event) => {
                  if (isSubmitting) {
                    event.preventDefault();
                    return;
                  }

                  onSelect(node);
                }}
              >
                <div className="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                  <div className="flex min-w-0 items-start gap-3">
                    <span
                      className="mt-1 h-3 w-3 shrink-0 rounded-full"
                      style={{ backgroundColor: nodeColor }}
                    />
                    <span className="min-w-0">
                      <span className="block truncate text-base font-semibold">
                        {node.title}
                      </span>
                      <span className="block truncate text-sm font-medium text-slate-500 dark:text-zinc-400">
                        {node.subtitle ?? node.id}
                      </span>
                    </span>
                  </div>
                  {node.status ? (
                    <span className="shrink-0 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">
                      {node.status}
                    </span>
                  ) : null}
                </div>

                <dl className="mt-4 grid min-w-0 gap-3 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
                  {visibleFields.map((field) => (
                    <div
                      key={field.key}
                      className="min-h-14 rounded-md bg-slate-50 p-3 dark:bg-zinc-900"
                    >
                      <dt className="text-xs font-semibold uppercase tracking-wide text-[#7C8886] dark:text-zinc-500">
                        {field.label}
                      </dt>
                      <dd className="mt-1 flex min-w-0 items-center gap-2 text-sm font-semibold text-slate-800 dark:text-zinc-100">
                        <span
                          className="h-2.5 w-2.5 shrink-0 rounded-full"
                          style={{ backgroundColor: mountedToColor }}
                        />
                        <span className="truncate">
                          {formatValue(node.fields[field.key])}
                        </span>
                      </dd>
                    </div>
                  ))}
                </dl>
              </Link>
            );
          })}
        </div>
      </div>
    </div>
  );
}

function StackView<TFieldKey extends string>({
  nodes,
  fields,
  activeNode,
  activePath,
  nodeById,
  buildHref,
  isSubmitting,
  onSelect,
}: {
  nodes: PreparedNode<TFieldKey>[];
  fields: HierarchyFieldDefinition<TFieldKey>[];
  activeNode?: PreparedNode<TFieldKey>;
  activePath: PreparedNode<TFieldKey>[];
  nodeById: Map<string, PreparedNode<TFieldKey>>;
  buildHref: (node: HierarchyNode<TFieldKey>) => string;
  isSubmitting: boolean;
  onSelect: (node: PreparedNode<TFieldKey>) => void;
}) {
  const visibleFields = fields.slice(0, 7);

  return (
    <div className="min-w-0 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
      <div className="mb-4 rounded-md bg-slate-50 p-3 dark:bg-zinc-900">
        <div className="flex flex-col gap-3">
          {activePath.map((node) => {
            const nodeColor = node.color;
            const mountedToColor = getMountedToColor(node, nodeById);
            const isActive = node.id === activeNode?.id;

            return (
              <Link
                key={node.id}
                href={buildHref(node)}
                aria-disabled={isSubmitting}
                className={`rounded-lg border bg-white p-4 shadow-sm transition dark:bg-zinc-950 ${
                  isActive
                    ? "border-[#FF6D00] bg-orange-50 dark:bg-orange-950/20"
                    : "border-slate-200 dark:border-zinc-800"
                } ${isSubmitting ? "pointer-events-none opacity-60" : ""}`}
                onClick={(event) => {
                  if (isSubmitting) {
                    event.preventDefault();
                    return;
                  }

                  onSelect(node);
                }}
              >
                <div className="flex min-w-0 items-start gap-3">
                  <span
                    className="flex h-9 w-9 shrink-0 items-center justify-center rounded-md text-sm font-bold text-white"
                    style={{ backgroundColor: nodeColor }}
                  >
                    {node.depth + 1}
                  </span>
                  <div
                    className="min-w-0 flex-1 border-l-4 pl-3"
                    style={{ borderColor: nodeColor }}
                  >
                    <span className="block truncate text-base font-semibold">
                      {node.title}
                    </span>
                    <span className="block truncate text-sm text-slate-500 dark:text-zinc-400">
                      {node.subtitle ?? node.id}
                    </span>
                    <div className="mt-3 grid gap-2 sm:grid-cols-2">
                      <MetaChip label="Serial" value={node.serialNumber} />
                      <MetaChip label="Version" value={node.partVersion} />
                    </div>
                    <div className="mt-3 rounded-md bg-slate-50 p-3 dark:bg-zinc-900">
                      <p className="text-xs font-semibold uppercase tracking-wide text-[#7C8886] dark:text-zinc-500">
                        {visibleFields[0]?.label ?? "Mounted to"}
                      </p>
                      <p className="mt-1 flex items-center gap-2 text-sm font-semibold text-slate-800 dark:text-zinc-100">
                        <span
                          className="h-2.5 w-2.5 shrink-0 rounded-full"
                          style={{ backgroundColor: mountedToColor }}
                        />
                        {formatValue(
                          visibleFields[0]
                            ? node.fields[visibleFields[0].key]
                            : node.parentId,
                        )}
                      </p>
                    </div>
                  </div>
                </div>
              </Link>
            );
          })}
        </div>
      </div>

      <div className="grid min-w-0 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {nodes.map((node) => (
          <button
            key={node.id}
            type="button"
            disabled={isSubmitting}
            className={`min-h-16 rounded-md border px-3 py-2 text-left transition ${
              node.id === activeNode?.id
                ? "border-[#00249C] bg-blue-50 text-[#00249C] dark:bg-blue-950/30 dark:text-blue-200"
                : "border-slate-200 bg-white text-slate-700 hover:border-[#5C9DAE] dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-300"
            } disabled:cursor-not-allowed disabled:opacity-60`}
            onClick={() => onSelect(node)}
          >
            <span className="block truncate text-sm font-semibold">
              {node.title}
            </span>
            <span className="mt-1 block truncate text-xs text-slate-500 dark:text-zinc-500">
              Serial {formatValue(node.serialNumber)}
              {node.partVersion ? ` | Version ${node.partVersion}` : ""}
            </span>
          </button>
        ))}
      </div>
    </div>
  );
}

function SegmentedControl({
  label,
  value,
  options,
  isDisabled,
  onChange,
}: {
  label: string;
  value: string;
  options: { value: string; label: string }[];
  isDisabled: boolean;
  onChange: (value: string) => void;
}) {
  return (
    <fieldset className="min-w-0">
      <legend className="mb-1 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-500">
        {label}
      </legend>
      <div className="flex rounded-lg border border-slate-200 bg-white p-1 shadow-sm dark:border-zinc-800 dark:bg-zinc-950">
        {options.map((option) => (
          <button
            key={option.value}
            type="button"
            disabled={isDisabled}
            className={`min-h-9 rounded-md px-3 text-sm font-semibold transition ${
              value === option.value
                ? "bg-[#00249C] text-white"
                : "text-slate-600 hover:bg-slate-100 dark:text-zinc-300 dark:hover:bg-zinc-900"
            } disabled:cursor-not-allowed disabled:opacity-60`}
            onClick={() => onChange(option.value)}
          >
            {option.label}
          </button>
        ))}
      </div>
    </fieldset>
  );
}

