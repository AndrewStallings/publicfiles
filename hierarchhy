function StatePanel({
  title,
  message,
  tone = "neutral",
}: {
  title: string;
  message: string;
  tone?: "neutral" | "error";
}) {
  return (
    <div
      className={`rounded-lg border p-6 shadow-sm ${
        tone === "error"
          ? "border-red-200 bg-red-50 text-red-950 dark:border-red-900 dark:bg-red-950/30 dark:text-red-100"
          : "border-slate-200 bg-white text-slate-950 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-50"
      }`}
    >
      <h2 className="text-lg font-semibold">{title}</h2>
      <p className="mt-2 text-sm opacity-80">{message}</p>
    </div>
  );
}

function prepareHierarchy(nodes: HierarchyNode[]) {
  const nodeById = new Map<string, PreparedNode>();

  nodes.forEach((node) => {
    nodeById.set(node.id, {
      ...node,
      children: [],
      color: "#00249C",
      depth: 0,
      rootId: node.id,
      path: [node.id],
    });
  });

  const roots: PreparedNode[] = [];

  nodeById.forEach((node) => {
    const parent = node.parentId ? nodeById.get(node.parentId) : undefined;

    if (parent) {
      parent.children.push(node);
    } else {
      roots.push(node);
    }
  });

  roots.sort(compareByTitle);
  nodeById.forEach((node) => node.children.sort(compareByTitle));
  roots.forEach((root) => applyNodeMetadata(root, 0, root.id, [root.id]));
  assignNodeColors(roots);

  return { roots, nodeById };
}

function applyNodeMetadata(
  node: PreparedNode,
  depth: number,
  rootId: string,
  path: string[],
) {
  node.depth = depth;
  node.rootId = rootId;
  node.path = path;

  node.children.forEach((child) =>
    applyNodeMetadata(child, depth + 1, rootId, [...path, child.id]),
  );
}

function orderNodes(
  roots: PreparedNode[],
  sortMode: HierarchySortMode,
) {
  return sortMode === "level" ? orderByLevel(roots) : orderByBranch(roots);
}

function orderByLevel(roots: PreparedNode[]) {
  const ordered: PreparedNode[] = [];
  const queue = [...roots];

  while (queue.length > 0) {
    const node = queue.shift();

    if (!node) {
      continue;
    }

    ordered.push(node);
    queue.push(...node.children);
  }

  return ordered;
}

function orderByBranch(roots: PreparedNode[]) {
  const ordered: PreparedNode[] = [];

  function visit(node: PreparedNode) {
    ordered.push(node);
    node.children.forEach(visit);
  }

  roots.forEach(visit);
  return ordered;
}

function assignNodeColors(roots: PreparedNode[]) {
  orderByBranch(roots).forEach((node, index) => {
    node.color = getNodeColor(index);
  });
}

function compareByTitle(left: PreparedNode, right: PreparedNode) {
  return left.title.localeCompare(right.title);
}

function getNodeColor(index: number) {
  const paletteColor = accentColors[index];

  if (paletteColor) {
    return paletteColor;
  }

  const hue = (index * 137.508) % 360;
  return `hsl(${hue.toFixed(1)} 76% 38%)`;
}

function getMountedToColor(
  node: PreparedNode,
  nodeById: Map<string, PreparedNode>,
) {
  if (!node.parentId) {
    return node.color;
  }

  return nodeById.get(node.parentId)?.color ?? node.color;
}

function formatValue(value: HierarchyFieldValue) {
  if (value === null || value === undefined || value === "") {
    return "Not provided";
  }

  return String(value);
}
