      <p className="text-xs font-semibold uppercase tracking-wide text-[#7C8886] dark:text-zinc-500">
        {label}
      </p>
      <p className="mt-1 truncate text-sm font-semibold text-slate-800 dark:text-zinc-100">
        {formatValue(value)}
      </p>
    </div>
  );
}

